import Base
import gralha-image@0.1.0.1/image.bend as Img
import gralha-text-scan@0.1.0.1/scan.bend as U
import gralha-bytes@0.1.0.1/bytes.bend as Bin
import ../jpeg.bend as JPEG

def empty(picture: Img.Picture) -> String:
  Img.Picture{w, h, depth, image} = picture
  U.choose(String, U32.is_eq(w, 0) && U32.is_eq(h, 0), "PASS", "FAIL")

def main() -> IO(Unit):
  do IO<Unit>:
    Unit <- IO.print("jpeg-signature: " ++ empty(JPEG.jpeg.decode(Bin.base64("bm90IGpwZWc="))))
    Unit <- IO.print("jpeg-empty-frame: " ++ empty(JPEG.jpeg.decode(Bin.base64("/9j/2Q=="))))
    Unit <- IO.print("jpeg-truncated: " ++ empty(JPEG.jpeg.decode(Bin.base64(""))))
    Unit <- IO.print("jpeg-entropy-truncated: " ++ empty(JPEG.jpeg.decode(Bin.base64(""))))
    Unit <- IO.print("jpeg-zero-quant: " ++ empty(JPEG.jpeg.decode(Bin.base64(""))))
    Unit <- IO.print("jpeg-missing-quant: " ++ empty(JPEG.jpeg.decode(Bin.base64(""))))
    Unit <- IO.print("jpeg-precision: " ++ empty(JPEG.jpeg.decode(Bin.base64(""))))
    Unit <- IO.print("jpeg-dimensions: " ++ empty(JPEG.jpeg.decode(Bin.base64(""))))
    Unit <- IO.print("jpeg-sampling: " ++ empty(JPEG.jpeg.decode(Bin.base64(""))))
    Unit <- IO.print("jpeg-selector: " ++ empty(JPEG.jpeg.decode(Bin.base64(""))))
    Unit <- IO.print("jpeg-spectral: " ++ empty(JPEG.jpeg.decode(Bin.base64(""))))
    Unit <- IO.print("jpeg-restart: " ++ empty(JPEG.jpeg.decode(Bin.base64(""))))
    IO.print("jpeg-arithmetic: " ++ empty(JPEG.jpeg.decode(Bin.base64(""))))

#|jpeg-signature: PASS
#|jpeg-empty-frame: PASS
#|jpeg-truncated: PASS
#|jpeg-entropy-truncated: PASS
#|jpeg-zero-quant: PASS
#|jpeg-missing-quant: PASS
#|jpeg-precision: PASS
#|jpeg-dimensions: PASS
#|jpeg-sampling: PASS
#|jpeg-selector: PASS
#|jpeg-spectral: PASS
#|jpeg-restart: PASS
#|jpeg-arithmetic: PASS
