import Base
import gralha-text-scan@0.1.0.0/scan.bend as U
import gralha-bytes@0.1.0.0/bytes.bend as Bin
import ../font.bend as Font

# A Noto Sans subset (fontTools, "AVTo.,We" plus e-acute, kern feature kept) read
# back as a font book face; expectations come from fontTools' outlines, metrics
# and GPOS pair data, in the text font format the checks use.
def glyph.show(+cp: U32, g: Font.FontGlyph) -> String:
  Font.FontGlyph{advance, outline, gid, leftClass, rightClass} = g
  "g|0:" ++ U.choose(String, U32.is_eq(cp, 0), "?", U32.show(cp)) ++ "|" ++ F32.show(advance) ++ " " ++ U32.show(gid) ++ " " ++ U32.show(leftClass) ++ " " ++ U32.show(rightClass) ++ "|" ++ outline

def glyph(+book: Font.FontBook, +cp: U32) -> String:
  glyph.show(cp, Font.font.glyph(book, 0, cp))

# A class-pair key (leftClass * 128 + rightClass) looked up through the face's GPOS.
def kern(+book: Font.FontBook, +key: U32) -> String:
  "k|0:" ++ U32.show(key) ++ "|" ++ F32.show(Font.font.kern(book, 0, 0, U32.div(key, 128), 0, U32.mod(key, 128)))

def metric(+book: Font.FontBook, +name: String) -> String:
  "m|0:" ++ name ++ "|" ++ F32.show(Font.font.metric(book, 0, name, 1000000.0))

def main() -> IO(Unit):
  +book = Font.font.ttf.base64(0, "", Font.font.empty())
  do IO<Unit>:
    Unit <- IO.print(glyph(book, 0))
    Unit <- IO.print(glyph(book, 44))
    Unit <- IO.print(glyph(book, 46))
    Unit <- IO.print(glyph(book, 65))
    Unit <- IO.print(glyph(book, 84))
    Unit <- IO.print(glyph(book, 86))
    Unit <- IO.print(glyph(book, 87))
    Unit <- IO.print(glyph(book, 111))
    Unit <- IO.print(glyph(book, 233))
    Unit <- IO.print(kern(book, 259))
    Unit <- IO.print(kern(book, 261))
    Unit <- IO.print(kern(book, 385))
    Unit <- IO.print(kern(book, 386))
    Unit <- IO.print(kern(book, 388))
    Unit <- IO.print(kern(book, 513))
    Unit <- IO.print(kern(book, 514))
    Unit <- IO.print(kern(book, 516))
    Unit <- IO.print(kern(book, 517))
    Unit <- IO.print(kern(book, 643))
    Unit <- IO.print(kern(book, 645))
    Unit <- IO.print(metric(book, "subscript"))
    Unit <- IO.print(metric(book, "superscript"))
    Unit <- IO.print(metric(book, "ascender"))
    Unit <- IO.print(metric(book, "descender"))
    IO.print(metric(book, "xheight"))

