import Base
import ../svg.bend as SVG
import gralha-text-scan@0.1.0.0/scan.bend as U
import gralha-bytes@0.1.0.0/bytes.bend as Bin
import gralha-image@0.1.0.0/image.bend as Img
import gralha-jpeg-decode@0.1.0.0/jpeg.bend as JPEG

def close(a: F32, b: U32) -> Bool:
  F32.is_le(F32.abs((a * 255.0 - U32.to_f32(b) : F32)), 3.001)

def pixel(c: Img.Color, +expected: Bin.Bytes, +at: U32) -> Bool:
  Img.Color{r, g, b, a} = c
  F32.is_eq(a, 1.0) && close(r, Bin.bytes.get(expected, at)) && close(g, Bin.bytes.get(expected, U32.inc(at))) && close(b, Bin.bytes.get(expected, (at + 2 : U32)))

def pixels(n: Nat, +index: U32, +w: U32, +raster: SVG.Raster, +expected: Bin.Bytes) -> Bool:
  match n:
    case 0n: True{}
    case 1n+d: pixel(SVG.raster.pixel(raster, U32.to_f32(U32.mod(index, w)), U32.to_f32(U32.div(index, w))), expected, (index * 3 : U32)) && pixels(d, U32.inc(index), w, raster, expected)

def check(+picture: Img.Picture, +w: U32, +h: U32, expected: Bin.Bytes) -> String:
  Img.Picture{width, height, depth, image} = picture
  U.choose(String, U32.is_eq(width, w) && U32.is_eq(height, h) && pixels(U32.to_nat((w * h : U32)), 0, w, SVG.raster.image(picture), expected), "PASS", "FAIL")

def main() -> IO(Unit):
  do IO<Unit>:
    Unit <- IO.print("jpeg-gray: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-444: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-422: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-420: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-restart: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-progressive-gray: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-progressive-444: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-progressive-422: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-progressive-420: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-progressive-restart: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-rgb: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-cmyk: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-ycck: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-progressive-cmyk: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-noise: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-progressive-noise: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-separate: " ++ check(JPEG.jpeg.decode(Bin.base64("/9j/2wBDAAEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQH/xAAmAAEAAAAAAAAAAAAAAAAAAAAAEAEAAAAAAAAAAAAAAAAAAAAA/8AAEQgAEQATAwEiAAIRAAMRAP/aAAgBAQAAPwAAAD//2gAIAQIAAD8AAP/aAAgBAwAAPwAA/9k=")), 19, 17, Bin.base64("")))
    Unit <- IO.print("jpeg-quant16: " ++ check(JPEG.jpeg.decode(Bin.base64("/9j/2wCDEAABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQAB/8QAJgABAAAAAAAAAAAAAAAAAAAAABABAAAAAAAAAAAAAAAAAAAAAP/BABEIABEAEwMBIgACEQADEQD/2gAMAwEAAgADAAA/AAAAAAAAAP/Z")), 19, 17, Bin.base64("")))
    IO.print("jpeg-huffman16: " ++ check(JPEG.jpeg.decode(Bin.base64("")), 19, 17, Bin.base64("")))

