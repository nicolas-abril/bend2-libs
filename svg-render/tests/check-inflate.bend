import Base
import ../svg.bend as SVG
import gralha-text-scan@0.1.0.0/scan.bend as U
import gralha-bytes@0.1.0.0/bytes.bend as Bin

def same(n: Nat, +at: U32, +a: Bin.Bytes, +b: Bin.Bytes) -> Bool:
  match n:
    case 0n: True{}
    case 1n+d: U32.is_eq(Bin.bytes.get(a, at), Bin.bytes.get(b, at)) && same(d, U32.inc(at), a, b)

def check(+result: Bin.Inflate, +expected: Bin.Bytes, valid: Bool) -> String:
  Bin.Inflate{stream, output} = result
  +out = output
  U.choose(String, U.choose(Bool, valid, Bin.bits.valid(stream) && U32.is_eq(Bin.bytes.size(out), Bin.bytes.size(expected)) && same(U32.to_nat(Bin.bytes.size(expected)), 0, out, expected), Bool.not(Bin.bits.valid(stream))), "PASS", "FAIL")

def main() -> IO(Unit):
  do IO<Unit>:
    Unit <- IO.print("empty: " ++ check(SVG.inflate(Bin.base64("AwA="), 8192), Bin.base64(""), True{}))
    Unit <- IO.print("stored: " ++ check(SVG.inflate(Bin.base64(""), 8192), Bin.base64(""), True{}))
    Unit <- IO.print("fixed: " ++ check(SVG.inflate(Bin.base64("S0xKTgSjiMioxFH2KHuUPcomgg0A"), 8192), Bin.base64(""), True{}))
    Unit <- IO.print("overlap: " ++ check(SVG.inflate(Bin.base64("S0wcBaOA+gAA"), 8192), Bin.base64(""), True{}))
    Unit <- IO.print("dynamic: " ++ check(SVG.inflate(Bin.base64(""), 8192), Bin.base64(""), True{}))
    Unit <- IO.print("blocks: " ++ check(SVG.inflate(Bin.base64(""), 8192), Bin.base64(""), True{}))
    Unit <- IO.print("truncated: " ++ check(SVG.inflate(Bin.base64(""), 8192), Bin.base64(""), False{}))
    Unit <- IO.print("distance: " ++ check(SVG.inflate(Bin.base64("AwI="), 8192), Bin.base64(""), False{}))
    Unit <- IO.print("invalid-type: " ++ check(SVG.inflate(Bin.base64("Bw=="), 8192), Bin.base64(""), False{}))
    Unit <- IO.print("stored-complement: " ++ check(SVG.inflate(Bin.base64("AQEA//94"), 8192), Bin.base64(""), False{}))
    IO.print("output-limit: " ++ check(SVG.inflate(Bin.base64("S0wcBaOA+gAA"), 32), Bin.base64(""), False{}))

