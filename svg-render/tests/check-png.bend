import Base
import ../svg.bend as SVG
import gralha-text-scan@0.1.0.0/scan.bend as U
import gralha-bytes@0.1.0.0/bytes.bend as Bin
import gralha-image@0.1.0.0/image.bend as Img
import gralha-png-decode@0.1.0.0/png.bend as PNG

def close(+a: F32, b: F32) -> Bool:
  F32.is_lt(F32.abs((a - b : F32)), 0.00002)

def pixel(c: Img.Color, +expected: Bin.Bytes, +at: U32) -> Bool:
  Img.Color{r, g, b, a} = c
  +alpha = (U32.to_f32(Bin.bytes.be(expected, (at + 6 : U32), 2n, 0)) / 65535.0 : F32)
  close(a, alpha) && close(r, (U32.to_f32(Bin.bytes.be(expected, at, 2n, 0)) / 65535.0 * alpha : F32)) && close(g, (U32.to_f32(Bin.bytes.be(expected, (at + 2 : U32), 2n, 0)) / 65535.0 * alpha : F32)) && close(b, (U32.to_f32(Bin.bytes.be(expected, (at + 4 : U32), 2n, 0)) / 65535.0 * alpha : F32))

def pixels(n: Nat, +index: U32, +w: U32, +raster: SVG.Raster, +expected: Bin.Bytes) -> Bool:
  match n:
    case 0n: True{}
    case 1n+d: pixel(SVG.raster.pixel(raster, U32.to_f32(U32.mod(index, w)), U32.to_f32(U32.div(index, w))), expected, (index * 8 : U32)) && pixels(d, U32.inc(index), w, raster, expected)

def check(+picture: Img.Picture, expected: Bin.Bytes, +w: U32, +h: U32) -> String:
  Img.Picture{width, height, depth, image} = picture
  U.choose(String, U32.is_eq(width, w) && U32.is_eq(height, h) && pixels(U32.to_nat((w * h : U32)), 0, w, SVG.raster.image(picture), expected), "PASS", "FAIL")

